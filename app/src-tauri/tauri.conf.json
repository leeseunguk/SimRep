{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimRep",
  "version": "0.1.0",
  "identifier": "dev.simrep.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SimRep",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../../ai/*.mjs": "ai/",
      "../../ai/package.json": "ai/package.json",
      "../../ai/node_modules/": "ai/node_modules/",
      "../../mcp/server.mjs": "mcp/server.mjs"
    },
    "targets": ["nsis"],
    "publisher": "SimRep",
    "shortDescription": "Ion optics studio",
    "category": "Education",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["English", "Korean"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
